  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=120%><color=#FFD700><b>HOW TO WIN</b></color></size>\n\n<color=#00FF00><b>1.
    BUILD YOUR GRID</b></color>\nFind Tetris blocks scattered across the map and
    bring them to your base. Fill your <b>5x5 Grid</b> to unlock the endgame.\n\n<color=#FF4500><b>2.
    SABOTAGE & STEAL</b></color>\nTo steal a piece from an opponent's grid:\n\u2022
    Pick up weapons around the map.\n\u2022 <b>Eliminate</b> the player (they respawn
    in 10s).\n\u2022 Once killed, their panel is unlocked for you!\n<i>Note: Panels
    have a <b>30s cooldown</b> after a piece is stolen.</i>\n\n<color=#FFD700><b>3.
    CLAIM THE CROWN</b></color>\nWhen a grid is complete, the <b>Center Vault</b>
    opens. \n\u2022 Everyone is alerted! \n\u2022 Race to the middle to collect your
    <b>Crown</b>.\n\u2022 Beware: Others can still kill you and steal pieces to reset
    your progress!\n\n<align=center><size=120%><i>First to the Crown wins!</i></size></align>\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
